@page "/admin/contacts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using w2sz.org.Components.Pages.Home
@using w2sz.org.Data
@using w2sz.org.Repositories
@inject ApplicationState State
@inject IOfficerDataRepo _OfficerDataRepo

<PageTitle>Edit Contact List</PageTitle>

<LeftBannerAdmin selectedPage="contacts" />
<div id="page_content">
    <h3>Edit Contact List</h3>
    @if (officers == null || dynamicOfficerList == null)
    {
        <p>Loading Officers...</p>
    }
    else
    {
        <OfficerList @ref="officerCompRef"/>
        <EditForm Model="dynamicOfficerList" method="post" OnValidSubmit="EditContactData" FormName="editOfficer">
            <table id="officer_list">
                @foreach (var officer in dynamicOfficerList)
                {
                    <tr class="officer_list_item">
                        <td><input type="text" class="officer_position" @bind-value="@officer.OfficerTitle"  /></td>
                        <td><input type="text" class="officer_identification" @bind-value="@officer.OfficerName" /></td>
                        <td><input type="text" class="officer_callsign" @bind-value="@officer.OfficerCallsign" /></td>
                        <td><input type="text" class="officer_email" @bind-value="@officer.OfficerEmail" /></td>
                    </tr>
                }
            </table>
            <input type="submit" value="submit" />
        </EditForm>
    }
</div>