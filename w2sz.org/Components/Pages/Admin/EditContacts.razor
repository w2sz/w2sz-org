@page "/admin/contacts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using w2sz.org.Components.Pages.Home
@using w2sz.org.Data
@using w2sz.org.Repositories
@inject ApplicationState State
@inject IOfficerDataRepo _OfficerDataRepo
@inject IStationTrusteeDataRepo _StationTrusteeDataRepo

<PageTitle>Edit Contact List</PageTitle>

<LeftBannerAdmin selectedPage="contacts" />
<div id="page_content">
    <h3>Edit Officer List</h3>
    @if (officers == null || dynamicOfficerList == null)
    {
        <p>Loading Officers...</p>
    }
    else
    {
        <OfficerList @ref="officerCompRef"/>
        <EditForm Model="dynamicOfficerList" method="post" OnValidSubmit="EditOfficerData" FormName="editOfficer">
            <table id="officer_list">
                @foreach (var officer in dynamicOfficerList)
                {
                    <tr class="officer_list_item">
                        <td><input type="text" class="officer_position" @bind-value="@officer.OfficerTitle"  /></td>
                        <td><input type="text" class="officer_identification" @bind-value="@officer.OfficerName" /></td>
                        <td><input type="text" class="officer_callsign" @bind-value="@officer.OfficerCallsign" /></td>
                        <td><input type="text" class="officer_email" @bind-value="@officer.OfficerEmail" /></td>
                    </tr>
                }
            </table>
            <input type="submit" value="submit" />
        </EditForm>
    }

    <br />

    @if (trustee == null || dynamicTrusteeDisp == null)
    {
        <p>Loading Trustee...</p>
    }
    else
    {
        <StationTrustee @ref="trusteeCompRef"/>
        <EditForm Model="dynamicTrusteeDisp" method="post" OnValidSubmit="EditTrusteeData" FormName="editTrustee">
            <table id="trustee_display">
                <!-- This is using a for loop for consistency but there is only 1 entry -->
                @foreach (var trustee in dynamicTrusteeDisp)
                {
                    <tr class="trustee_disp_item">
                        <td><input type="text" class="trustee_prefix" @bind-value="@trustee.TrusteePrefix" /></td>
                        <td><input type="text" class="trustee_identification" @bind-value="@trustee.TrusteeName" /></td>
                        <td><input type="text" class="trustee_callsign" @bind-value="@trustee.TrusteeCallsign" /></td>
                        <td><input type="text" class="trustee_email" @bind-value="@trustee.TrusteeEmail" /></td>
                    </tr>
                }
            </table>
            <input type="submit" value="submit" />
        </EditForm>
    }
</div>
