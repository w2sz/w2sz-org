@implements IDisposable
@inject NavigationManager NavigationManager

<div id="navbar">
    <div id="navbar_content">
        <a href="/"><img id="logo" src="Assets/w2sz-logo-white.png" alt="W2SZ Logo" /></a>
        <ul id="navigation_items">
            <li class="navigation_item"><a class="navigation_item_text" href="/">Home</a></li>
            <li class="navigation_item"><a class="navigation_item_text" href="/posts">Posts</a></li>
            <li class="navigation_item"><a class="navigation_item_text" href="https://wiki.w2sz.org">Wiki</a></li>
            <li class="navigation_item"><a class="navigation_item_text" href="/gallery">Gallery</a></li>
            <li class="navigation_item"><a class="navigation_item_text" href="/logs">Logbook</a></li>
            <li class="navigation_item"><a class="navigation_item_text" href="/donate">Donate</a></li>
            <AuthorizeView>
                <Authorized>
                    <li class="navigation_item">
                        <form id="logout_button" action="admin/logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button id="logout_button_text" type="submit" class="navigation_item_text">Logout</button>
                        </form>
                    </li>
                </Authorized>
            </AuthorizeView>
        </ul>
    </div>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}